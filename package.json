{
  "name": "water-bottle-tracker-system",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --prefix src/backend",
    "dev:frontend": "npm run dev --prefix src/frontend",
    "start": "npm run start --prefix src/backend",
    "build": "npm run build --prefix src/frontend",
    "install:all": "npm install --prefix src/backend && npm install --prefix src/frontend"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0"
  }
}
